# Backend base URL. The storefront calls {VITE_API_URL}/api/v1,
# the admin app calls {VITE_API_URL}/api/v1/admin.
VITE_API_URL=http://localhost:4000

# Google Maps JS API key (Maps JavaScript API + Places API enabled).
# Powers the location search + pin picker in Store Management → Footer.
# Optional: without it the picker falls back to manual latitude/longitude
# fields, and the storefront's "View on Google Maps" links work regardless.
VITE_GOOGLE_MAPS_API_KEY=AIzaSyD03wRxbSdeh53aeRBoo1c4iJZeCDO_-vQ
